# Investigador principal — Claude (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Fallback 1 — OpenAI (platform.openai.com). Lê PDF nativamente (gpt-4o+).
OPENAI_API_KEY=sk-...
# Opcional — modelo OpenAI (padrão: gpt-4o)
OPENAI_MODEL=gpt-4o

# Fallback 2 + revisora cega — DeepSeek (platform.deepseek.com)
DEEPSEEK_API_KEY=sk-...

# Opcional — Postgres do Railway (login e casos salvos). No Railway, use a referência: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Recomendada se usar contas — segredo fixo das sessões (qualquer frase longa aleatória). Sem ele, todo redeploy desloga os usuários.
JWT_SECRET=

# Contas fechadas (admin + 1 cliente). O servidor cria/atualiza essas contas no boot.
# Senhas com no mínimo 8 caracteres. No Railway: Variables → New Variable.
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=
CLIENT_EMAIL=cliente@seudominio.com
CLIENT_PASSWORD=

# Opcionais — anti-bot Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
